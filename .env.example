# ============================================================
#  Variables de entorno — copia este archivo como ".env"
#  y completa los valores. NUNCA subas el .env real al repo.
# ============================================================

# --- Speckle ---
# Servidor de Speckle (nube pública por defecto)
VITE_SPECKLE_SERVER_URL=https://app.speckle.systems
# IDs del modelo de coordinación (del proyecto Hospital de Coquimbo)
VITE_SPECKLE_PROJECT_ID=1a3ef97d52
VITE_SPECKLE_MODEL_ID=51f6f1a7ce
# Token de solo-lectura. Dejar VACÍO si el modelo es PÚBLICO.
# Para modelo privado en producción, servir el token desde backend, NO aquí.
VITE_SPECKLE_TOKEN=

# --- Supabase (fase 2, aún no requerido) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Fuente de datos de avance ---
# "mock"  -> usa src/data/mockAvance.json (fase 1, actual)
# "supabase" -> usa la base de datos (fase 2)
VITE_DATA_SOURCE=mock
